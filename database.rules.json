{
  "rules": {
    "admins": {
      "$k": {
        ".read": "auth != null && auth.token.email_verified == true && $k == auth.token.email.toLowerCase().replace('.', ',')",
        ".write": false
      }
    },
    "workspaces": {
      ".read": "auth != null && auth.token.email_verified == true && root.child('admins').child(auth.token.email.toLowerCase().replace('.', ',')).val() == true",
      ".write": "auth != null && auth.token.email_verified == true && root.child('admins').child(auth.token.email.toLowerCase().replace('.', ',')).val() == true",
      "$ws": {
        ".read": "auth != null && auth.token.email_verified == true && (root.child('admins').child(auth.token.email.toLowerCase().replace('.', ',')).val() == true || data.child('members').child(auth.token.email.toLowerCase().replace('.', ',')).exists())"
      }
    },
    "userWorkspaces": {
      ".write": "auth != null && auth.token.email_verified == true && root.child('admins').child(auth.token.email.toLowerCase().replace('.', ',')).val() == true",
      "$k": {
        ".read": "auth != null && auth.token.email_verified == true && ($k == auth.token.email.toLowerCase().replace('.', ',') || root.child('admins').child(auth.token.email.toLowerCase().replace('.', ',')).val() == true)"
      }
    },
    "boards": {
      "$board": {
        ".read": "auth != null && auth.token.email_verified == true && (root.child('admins').child(auth.token.email.toLowerCase().replace('.', ',')).val() == true || root.child('workspaces').child(root.child('boards').child($board).child('info').child('ws').val()).child('members').child(auth.token.email.toLowerCase().replace('.', ',')).exists())",
        ".write": "auth != null && auth.token.email_verified == true && root.child('admins').child(auth.token.email.toLowerCase().replace('.', ',')).val() == true",
        "data": {
          ".write": "auth != null && auth.token.email_verified == true && (root.child('admins').child(auth.token.email.toLowerCase().replace('.', ',')).val() == true || root.child('workspaces').child(root.child('boards').child($board).child('info').child('ws').val()).child('members').child(auth.token.email.toLowerCase().replace('.', ',')).child('role').val() == 'editor')"
        },
        "presence": {
          "$uid": {
            ".write": "auth != null && auth.token.email_verified == true && auth.uid == $uid && (root.child('admins').child(auth.token.email.toLowerCase().replace('.', ',')).val() == true || root.child('workspaces').child(root.child('boards').child($board).child('info').child('ws').val()).child('members').child(auth.token.email.toLowerCase().replace('.', ',')).exists())"
          }
        }
      }
    }
  }
}