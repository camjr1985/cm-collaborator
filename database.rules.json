{
  "rules": {
    "admins": {
      "$email": {
        ".read": "auth != null && auth.token.email_verified == true && auth.token.email.toLowerCase().replace('.', ',') == $email",
        ".write": false
      }
    },
    "boardIndex": {
      ".read": "auth != null && auth.token.email_verified == true && root.child('admins').child(auth.token.email.toLowerCase().replace('.', ',')).val() == true",
      ".write": "auth != null && auth.token.email_verified == true && root.child('admins').child(auth.token.email.toLowerCase().replace('.', ',')).val() == true"
    },
    "userBoards": {
      "$email": {
        ".read": "auth != null && auth.token.email_verified == true && (auth.token.email.toLowerCase().replace('.', ',') == $email || root.child('admins').child(auth.token.email.toLowerCase().replace('.', ',')).val() == true)",
        ".write": "auth != null && auth.token.email_verified == true && root.child('admins').child(auth.token.email.toLowerCase().replace('.', ',')).val() == true"
      }
    },
    "boards": {
      "$board": {
        ".read": "auth != null && auth.token.email_verified == true && (root.child('admins').child(auth.token.email.toLowerCase().replace('.', ',')).val() == true || root.child('boards').child($board).child('members').child(auth.token.email.toLowerCase().replace('.', ',')).exists())",
        ".write": "auth != null && auth.token.email_verified == true && root.child('admins').child(auth.token.email.toLowerCase().replace('.', ',')).val() == true",
        "data": {
          ".write": "auth != null && auth.token.email_verified == true && (root.child('admins').child(auth.token.email.toLowerCase().replace('.', ',')).val() == true || root.child('boards').child($board).child('members').child(auth.token.email.toLowerCase().replace('.', ',')).child('role').val() == 'editor')"
        },
        "presence": {
          "$uid": {
            ".write": "auth != null && auth.uid == $uid && auth.token.email_verified == true && (root.child('admins').child(auth.token.email.toLowerCase().replace('.', ',')).val() == true || root.child('boards').child($board).child('members').child(auth.token.email.toLowerCase().replace('.', ',')).exists())"
          }
        }
      }
    }
  }
}
